# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Only needed if your Vercel preview URLs differ from NEXTAUTH_URL fallback.
# NEXTAUTH_URL=https://your-vercel-domain.vercel.app

# --- Google OAuth (https://console.cloud.google.com) ---
AUTH_GOOGLE_ID=your-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-client-secret

# --- Postgres ---
# Vercel Postgres and Neon auto-inject these when you attach the integration.
# If you're bringing your own Postgres, set both to your connection string
# (pooled + direct). For local dev a single URL is fine for both.
# The ingest drain runs several tournaments at once (see
# INGEST_DRAIN_CONCURRENCY below). Each in-flight job needs a connection for
# its claim and its writes — the long part of a job is network waiting and
# holds nothing — so keep connection_limit at or above the drain concurrency
# or the workers queue on the pool instead of the network.
POSTGRES_PRISMA_URL=postgres://user:pass@host/db?pgbouncer=true&connection_limit=6
POSTGRES_URL_NON_POOLING=postgres://user:pass@host/db

# --- Cron auth (set any random string; paste the same into Vercel env) ---
CRON_SECRET=

# How many tournaments the queue drain ingests simultaneously. Default 6,
# hard-capped at 16. Concurrency is per UPSTREAM HOST — never two ingests of
# the same tournament host at once — so this does not increase the request
# rate any single Tabbycat instance sees; it overlaps the ~24s each job
# spends idle in the politeness throttle. Raise only alongside
# connection_limit on POSTGRES_PRISMA_URL above.
# INGEST_DRAIN_CONCURRENCY=6

# --- Absolute site URL for metadata + sitemap (optional) ---
# Falls back to VERCEL_PROJECT_PRODUCTION_URL, then debate-cv.vercel.app.
# NEXT_PUBLIC_SITE_URL=https://debate-cv.vercel.app

# --- Token encryption at rest (32 bytes base64, openssl rand -base64 32) ---
TOKEN_ENCRYPTION_KEY=

# --- Tabbycat scraper ---
# Override the User-Agent sent to Tabbycat hosts. A realistic Chrome UA is the
# default; set this if a particular tournament still blocks the default.
# TABBYCAT_USER_AGENT=Mozilla/5.0 (...)

# --- Admin ---
# Comma-separated list of emails allowed to hit /admin and /api/admin/*.
# Example: ADMIN_EMAIL=you@example.com,colleague@example.com
ADMIN_EMAIL=

# --- Privacy contact ---
# Published on /privacy as the address for people who are IN the database
# but never signed up — anyone whose name was scraped off a public tab and
# now appears on someone else's CV as a teammate. They have no account and
# therefore no Settings page, so this is their only route to an erasure
# request (which an admin fulfils via POST /api/admin/persons/<id>/suppress).
# NEXT_PUBLIC_ prefixed because /privacy renders for signed-out visitors.
# Leave unset and the page falls back to the GitHub repo, which is worse but
# not broken.
# NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=privacy@example.com

# Floor for the gap between consecutive requests to the SAME tournament host.
# Default 600ms. This is a starting point, not a fixed rate: a host that
# answers 403/429/503 is automatically moved to 1500ms and doubles from there
# to a 3s ceiling for the rest of the process, so only hosts that actually
# push back pay the slow rate. Raise it only if a specific deployment sees
# widespread throttling.
# TABBYCAT_MIN_INTERVAL_MS=600

# --- Scraper proxy (optional, for persistent Cloudflare 403s) ---
# If Cloudflare's bot protection still blocks requests after the browser
# fingerprint + cookie jar, route fetches through ScraperAPI, which rotates
# residential IPs and handles Cloudflare automatically.
# Free tier: 1,000 requests/month. Get a key at https://www.scraperapi.com/
# Leave unset to use direct fetch (default).
# SCRAPER_API_KEY=

# --- Sentry error tracking (optional but recommended for production) ---
# DSN is public-by-design (it ends up in client-side bundles). Setting either
# variable enables Sentry; leaving both unset makes Sentry init a no-op so
# local dev works without a Sentry account. NEXT_PUBLIC_SENTRY_DSN is read by
# the browser bundle; SENTRY_DSN is the server-side fallback.
# NEXT_PUBLIC_SENTRY_DSN=https://....ingest.us.sentry.io/...
# SENTRY_DSN=https://....ingest.us.sentry.io/...
#
# Build-time only: lets `pnpm build` upload source maps to Sentry so prod
# stack traces resolve to your TypeScript source instead of minified output.
# Skip locally (the build plugin no-ops when missing). Set in Vercel for
# production deploys. Generate at: Sentry → User Settings → Auth Tokens
# (scopes: project:read, project:write, project:releases).
# SENTRY_AUTH_TOKEN=

# Optional: enables the admin-triggered Claude Haiku motion classifier on
# /admin/tags (pre-fills motion type/topic tag proposals for review). The
# tag system works fully without it — suggestions just have to be entered
# by hand. Create at: https://platform.claude.com → API keys.
# ANTHROPIC_API_KEY=
