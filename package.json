{
  "name": "debate-cv",
  "version": "0.2.0",
  "private": true,
  "description": "Debate CV: verified, shareable tournament records for university debaters.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/migrate-if-configured.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ratchet": "node scripts/check-ratchet.mjs",
    "file-size": "node scripts/check-file-size.mjs",
    "a11y": "node scripts/a11y-smoke.mjs",
    "knip": "knip",
    "dup": "jscpd",
    "arch": "depcruise app lib components proxy.ts instrumentation.ts --output-type err",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,css,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,css,yml}\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "postinstall": "prisma generate",
    "seed:dev": "node scripts/seed-dev-data.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^6.1.0",
    "@sentry/nextjs": "^10.76.2",
    "@tailwindcss/typography": "^0.5.19",
    "acorn": "^8.16.0",
    "cheerio": "^1.0.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "googleapis": "^144.0.0",
    "lucide-react": "^1.9.0",
    "next": "^16.4.3",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ajv": "^6.15.0",
    "autoprefixer": "^10.4.20",
    "dependency-cruiser": "17.4.3",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.4.3",
    "jscpd": "5.4.1",
    "knip": "6.41.0",
    "postcss": "^8.5.29",
    "prettier": "3.9.10",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
